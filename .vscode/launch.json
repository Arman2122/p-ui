{
  "$schema": "vscode://schemas/launch",
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run p-ui",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PUI_DEBUG": "true",
        "PUI_LOG_FOLDER": "p-ui",
        "PUI_BIN_FOLDER": "p-ui",
        "PUI_DB_DSN": "postgres://pui:puipass@127.0.0.1:5432/pui?sslmode=disable"
      },
      "console": "integratedTerminal"
    }
  ]
}
