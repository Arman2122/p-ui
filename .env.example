# This file serves a dual purpose:
# 1. Developer Bootstrap: The active (uncommented) variables directly below
#    configure a safe, unprivileged local environment for 'go run .'.
#    'cp .env.example .env' needs no root — but it does need a PostgreSQL you
#    can reach at PUI_DB_DSN below, since that is the only supported backend.
# 2. Production Reference: All available PUI_* configuration options are 
#    documented and commented out in the reference section further below.
#
# Penhoon UI reads its runtime configuration from PUI_* environment variables.
# On a script install, the installer writes them to the service environment file
# (/etc/default/p-ui).
#
# Defaults are sensible — set only what you need to change, then restart:
# systemctl restart p-ui

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT OVERRIDES (ACTIVE BY DEFAULT)
# ------------------------------------------------------------------------------
PUI_DEBUG=true
# Required — point this at a local PostgreSQL you can write to.
PUI_DB_DSN=postgres://pui:pui@127.0.0.1:5432/pui?sslmode=disable
PUI_LOG_FOLDER=p-ui
PUI_BIN_FOLDER=p-ui
PUI_INIT_WEB_BASE_PATH=/

# ==============================================================================
# REFERENCE CONFIGURATION (ALL OPTIONS)
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL is the only supported backend.
#
# REQUIRED: PostgreSQL connection string. The panel refuses to start without it.
# Example: postgres://user:password@localhost:5432/dbname?sslmode=disable
# (Set to a local development database in the block above.)
#PUI_DB_DSN=

# Max open connections in the PostgreSQL pool
#PUI_DB_MAX_OPEN_CONNS=

# Max idle connections in the PostgreSQL pool
#PUI_DB_MAX_IDLE_CONNS=


# ------------------------------------------------------------------------------
# Panel
# ------------------------------------------------------------------------------
# Override the panel port (1–65535). Takes precedence over the stored setting.
#PUI_PORT=

# Initial web base path on FIRST launch (e.g., /panel)
# Default: /
#PUI_INIT_WEB_BASE_PATH=/

# Enable Fail2ban-based IP-limit enforcement
# Default: true
#PUI_ENABLE_FAIL2BAN=true

# Skip the HSTS header — set true when TLS is terminated by a reverse proxy
# Default: false
#PUI_SKIP_HSTS=false


# ------------------------------------------------------------------------------
# Logging & binaries
# ------------------------------------------------------------------------------
# Logging level: debug, info, notice, warning, or error
# Default: info
#PUI_LOG_LEVEL=info

# Debug mode. Forces log level to debug, enables Gin debug mode, 
# and ensures frontend assets are served directly from disk (see CLAUDE.md).
# Default: false (Overridden to 'true' in the development block at the top)
#PUI_DEBUG=false

# Log output directory
# Default: /var/log/p-ui (Overridden to 'p-ui' in the development block above)
#PUI_LOG_FOLDER=/var/log/p-ui

# Folder for the Xray-core binary and geosite/geoip files
# Default: bin (Overridden to 'p-ui' in the development block above)
#PUI_BIN_FOLDER=bin

# Legacy Path Settings
# Main installation folder (Default: /usr/local/p-ui)
#PUI_MAIN_FOLDER=/usr/local/p-ui
# Path to the systemd service file (Default: /etc/systemd/system)
#PUI_SERVICE=/etc/systemd/system


# ------------------------------------------------------------------------------
# Memory & profiling
# ------------------------------------------------------------------------------
# Go GC target percentage; lower = less RAM, slightly more CPU.
# Default: 75
#PUI_GOGC=

# Minutes between FreeOSMemory calls; 0 disables.
# Default: 10
#PUI_MEMORY_RELEASE_INTERVAL=

# Go soft memory limit in MiB
#PUI_MEMORY_LIMIT=

# Go-syntax soft limit (e.g., 400MiB); takes precedence over PUI_MEMORY_LIMIT
#GOMEMLIMIT=

# Expose pprof profiling on 127.0.0.1:6060
# Default: false
#PUI_PPROF=false


# ------------------------------------------------------------------------------
# Xray
# ------------------------------------------------------------------------------
# Force VMess AEAD
# Default: false
#XRAY_VMESS_AEAD_FORCED=false


# ------------------------------------------------------------------------------
# Tunnel health monitor
# ------------------------------------------------------------------------------
# Optional watchdog: probes a URL (optionally through a local Xray inbound)
# and restarts Xray after repeated failures. A restart drops all connected clients.
# Default: false
#PUI_TUNNEL_HEALTH_MONITOR=false

# Proxy to send the probe through, e.g., socks5://127.0.0.1:1080
# Empty = only checks host connectivity
#PUI_TUNNEL_HEALTH_PROXY=

# URL to probe
# Default: https://www.cloudflare.com/cdn-cgi/trace
#PUI_TUNNEL_HEALTH_URL=https://www.cloudflare.com/cdn-cgi/trace

# Interval between probes
# Default: 30s
#PUI_TUNNEL_HEALTH_INTERVAL=30s

# Per-probe timeout
# Default: 10s
#PUI_TUNNEL_HEALTH_TIMEOUT=10s

# Consecutive failures before a restart
# Default: 3
#PUI_TUNNEL_HEALTH_FAILURES=3

# Minimum delay between restarts
# Default: 5m
#PUI_TUNNEL_HEALTH_COOLDOWN=5m


# ------------------------------------------------------------------------------
# Unattended install
# ------------------------------------------------------------------------------
# Set to 1 (or run with no TTY) to install with zero prompts.
# Generated credentials will be written to /etc/p-ui/install-result.env
#PUI_NONINTERACTIVE=1
