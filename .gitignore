# ── Editors / IDEs ───────────────────────────────────────────────────────────
.idea/
.cursor/
.specify/
.cache/
.sync*

# .vscode holds two files we deliberately SHARE (debug + build config). Ignoring
# the whole folder hid new files and contradicted those two being tracked.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Claude Code local state; the shared CLAUDE.md instructions stay tracked.
.claude/

# ── Dependencies / framework output ──────────────────────────────────────────
node_modules/
dist/

# ── Frontend build output embedded into the Go binary ────────────────────────
# `//go:embed all:dist` fails when the directory is missing, so .gitkeep is
# tracked and a fresh clone builds without running `make dist-stub` first.
# The `!internal/web/dist/` line is load-bearing: git cannot re-include a file
# whose PARENT directory is excluded, and `dist/` above excludes this one.
!internal/web/dist/
internal/web/dist/*
!internal/web/dist/.gitkeep
.next/
.source/
out/
storybook-static/
coverage/
*.tsbuildinfo

# ── Compiled binaries ────────────────────────────────────────────────────────
# The release workflow builds `pui-release`; local cross-compiles land as
# p-ui-<arch>. Anchored to the repo root so the tracked p-ui.sh and
# p-ui.service.debian are never caught.
/p-ui
/pui-release
/p-ui-linux-*
/p-ui-amd64
/p-ui-arm64
/p-ui-armv*
/p-ui-s390x
/p-ui-386
/main
*.exe
*.dll
*.so
*.dylib

# Go test / profiling artefacts
*.test
coverage.out
coverage.html
*.cover
*.prof

# ── Release archives and runtime state ───────────────────────────────────────
*.tar.gz
*.zip
release/
backup/
bin/
p-ui/
tmp/
*.log
system_metrics.gob
*.dump

# ── Secrets / environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
