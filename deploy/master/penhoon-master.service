[Unit]
Description=Penhoon management panel and node control plane
Wants=network-online.target
After=network-online.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=exec
User=penhoon-master
Group=penhoon-master
StateDirectory=penhoon-master
StateDirectoryMode=0700
LogsDirectory=penhoon-master
LogsDirectoryMode=0700
WorkingDirectory=/var/lib/penhoon-master
EnvironmentFile=/etc/penhoon/master.env
ExecStartPre=/usr/local/lib/penhoon-master/p-ui preflight
ExecStart=/usr/local/lib/penhoon-master/p-ui run
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
